 	$(PKG_BUILD_DIR)/hostTools/cmplzma -k -2 -lzma $(PKG_BUILD_DIR)/bootloaders/armtf/armtf.elf $(PKG_BUILD_DIR)/bootloaders/armtf/armtf.bin $(PKG_BUILD_DIR)/bootloaders/armtf/armtf.lz
 
